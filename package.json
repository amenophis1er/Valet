{
  "name": "valet",
  "version": "0.1.2",
  "description": "An AI agent that works in your own Chrome, with the model you bring. No server, no account, no companion app.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Amen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amenophis1er/Valet.git"
  },
  "homepage": "https://github.com/amenophis1er/Valet#readme",
  "bugs": {
    "url": "https://github.com/amenophis1er/Valet/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "browser-agent",
    "ai-agent",
    "llm",
    "tool-calling",
    "byok",
    "side-panel"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome lint && npm run lint:deps",
    "lint:deps": "depcruise src e2e scripts --output-type err-long",
    "test": "vitest run",
    "e2e": "playwright test",
    "dev": "node scripts/dev.mjs",
    "screenshots": "playwright test -c scripts/screenshots",
    "docs": "vitest run src/actions/reference.test.ts -u"
  },
  "dependencies": {
    "@amenophis1er/byok": "^0.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.13",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
