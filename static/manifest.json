{
  "manifest_version": 3,
  "name": "Errand",
  "version": "0.0.0",
  "description": "An AI agent that works in your own Chrome, with the model you bring. It needs access to every site because it works on the ones you ask it to, and asks before going anywhere new.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabs", "tabGroups", "scripting", "debugger", "storage", "sidePanel", "declarativeNetRequest", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Errand" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
